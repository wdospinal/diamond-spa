# COP per 1 USD (shown in admin next to dollar amounts). Used at build time on the client.
NEXT_PUBLIC_COP_PER_USD=4100

# Google Places API — only needed to refresh the reviews/rating snapshot in
# src/lib/place-details.json (not used at runtime).
# Create a key in Google Cloud Console and restrict it by API + HTTP referrer (web) or IP (server).
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Twilio — SMS notifications for new bookings
# Sign up at https://www.twilio.com and get these from your Console Dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX   # Your Twilio phone number

# The spa's phone that receives booking SMS notifications
BUSINESS_PHONE=+573054541635

# Admin app (https://app.diamondspa.com.co rewrites to /admin — or open /admin locally)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password
# Random string for signing the admin session cookie (e.g. openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# Contraseña INICIAL de cada cuenta del panel (usuario:contraseña, separadas por
# coma). En cuanto la persona la cambia desde /admin/account, se guarda su hash
# en la base de datos y la de aquí deja de valer para ella.
# El usuario no distingue mayúsculas; la contraseña sí. Sin comas ni ":" dentro
# de la contraseña.
ADMIN_USERS=sary:change-this-password,daniela:change-this-password,copper:change-this-password,daniel:change-this-password

# Optional: JSON file path for bookings (default: ./data/bookings.json). Serverless hosts need a DB instead.
# BOOKINGS_FILE=/var/lib/diamond-spa/bookings.json

# Optional: manual income/expense ledger (default: ./data/ledger.json)
# LEDGER_FILE=/var/lib/diamond-spa/ledger.json

# Resend — email notifications for new bookings (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Web Push notifications (admin new-booking / check-in alerts) ─────────────
# VAPID keys identify this server to the browser push services. Generate a pair
# with:  npx web-push generate-vapid-keys
# The PUBLIC key is exposed to the browser (NEXT_PUBLIC_*); keep PRIVATE secret.
# Subscriptions are stored in Vercel KV in production (see KV_REST_API_* below)
# and fall back to data/push-subs.json locally — that file is gitignored because
# it holds users' device push keys and must never be committed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@diamondspa.com

# ─── Sales funnel dashboard (/admin/funnel) ──────────────────────────────────
# The funnel is fed FIRST-PARTY: the browser posts stage hits to /api/funnel-hit
# (see src/lib/funnel-client.ts) and they are stored in the `funnel_hits` table.
# No env var is needed for that — it only requires the Supabase vars below (or
# KV) so the counters survive a deploy. Run supabase/migrations/0004_funnel_hits.sql.
#
# OPTIONAL, and no longer required: a Vercel Analytics Drain can additionally
# push Web Analytics events to /api/analytics-drain (Project → Drains → New
# Drain → Analytics, HTTP delivery, JSON encoding, endpoint
# https://<your-domain>/api/analytics-drain). Drains require a Pro plan. Paste
# the drain's signing secret here so the webhook can verify x-vercel-signature.
# Both writers dedupe on (day, stage, session), so enabling this is safe.
# For local testing, set any value and sign your test payload with the same secret.
VERCEL_DRAIN_SECRET=

# Durable store for the aggregated funnel counters. Connect a Vercel KV / Upstash
# Redis store to the project and these are injected automatically (UPSTASH_REDIS_*
# also accepted). Without them the app falls back to a local JSON file
# (data/funnel-daily.json) — fine for local dev, but NOT durable on Vercel's
# ephemeral filesystem, so set these in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: JSON file path for the local funnel fallback (default: ./data/funnel-daily.json)
# FUNNEL_FILE=/var/lib/diamond-spa/funnel-daily.json

# ─── Supabase (preferred durable store) ───────────────────────────────────────
# Postgres storage for bookings, blog posts, landing configs, and push
# subscriptions. Takes precedence over Vercel KV when set.
# 1. Create a project at https://supabase.com/dashboard
# 2. Run supabase/migrations/0001_init.sql in the SQL editor
# 3. Copy the values from Project Settings → API (use the service_role key —
#    server-side only, never expose it to the browser)
# 4. Import existing data once: npm run migrate-to-supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Bold — cierres de venta del datáfono (vía IMAP) ──────────────────────────
# Bold envía cada madrugada un correo de "cierre de ventas" a
# admin@diamondspa.com.co (buzón de Hostinger). La app lo lee por IMAP —solo
# lectura, con BODY.PEEK, sin marcar ni borrar nada— y suma el mes en
# /admin/bold. Sin estas variables la página sigue funcionando con la carga
# manual (pegar el correo), pero no se sincroniza sola.
#
# Recomendado: si Hostinger lo permite, crear un buzón/alias aparte solo para
# esta lectura, en vez de usar la contraseña del correo principal.
BOLD_IMAP_HOST=imap.hostinger.com
BOLD_IMAP_PORT=993
BOLD_IMAP_USER=admin@diamondspa.com.co
BOLD_IMAP_PASSWORD=
# Remitente por el que se filtra el buzón (por defecto no-responder@bold.co)
# BOLD_SENDER=no-responder@bold.co

# Protege /api/bold/sync frente a llamadas externas. Lo creas tú (por ejemplo
# con `openssl rand -hex 32`) y lo guardas en Project → Settings → Environment
# Variables: Vercel lo manda como `Authorization: Bearer <CRON_SECRET>` en cada
# ejecución del cron. Si no se define, la ruta solo acepta la cookie de admin
# y el cron recibirá 401. El botón "Sincronizar ahora" del panel usa la cookie,
# así que no lo necesita.
CRON_SECRET=

# Opcional: ruta del JSON de respaldo local (por defecto ./data/bold-closings.json)
# BOLD_FILE=/var/lib/diamond-spa/bold-closings.json
